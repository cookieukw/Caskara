Group #CaskaraAdminOverlay {
  LayoutMode: CenterMiddle;
  Group #Window {
    Anchor: (Height: 650);
    LayoutMode: Top;
    Background: #121212;
    Group #Header {
      Anchor: (Height: 65);
      Padding: (Left: 25, Right: 25);
      LayoutMode: Left;
      Background: #1A1A1A;
      Group #HeaderLeft {
        LayoutMode: Left;
        FlexWeight: 1;
        Label #Logo {
          Text: "DB";
          Anchor: (Right: 15);
          Style: (FontSize: 26, TextColor: #FFB000, VerticalAlignment: Center);
        }
        Label #Title {
          Text: "Caskara DB Admin";
          Style: (FontSize: 22, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center);
        }
      }
      Group #HeaderActions {
        LayoutMode: Right;
        Button #BtnBackup {
          Anchor: (Height: 35);
          Padding: (Left: 15, Right: 15);
          Background: #FFB000;
          Label {
            Text: "Backup Now";
            Style: (TextColor: #222222, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
        Button #BtnVacuum {
          Anchor: (Height: 35, Right: 12);
          Padding: (Left: 15, Right: 15);
          Background: #222222;
          Label {
            Text: "Vacuum DB";
            Style: (TextColor: #FFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }
    }
    Group #Body {
      LayoutMode: Left;
      FlexWeight: 1;
      Group #Sidebar {
        Anchor: (Width: 220);
        Padding: (Top: 25, Bottom: 25, Left: 15, Right: 15);
        LayoutMode: Top;
        Background: #161616;
        Label #ShellsTitle {
          Text: "DATABASE SHELLS";
          Anchor: (Bottom: 12);
          Padding: (Left: 10);
          Style: (FontSize: 12, TextColor: #BBBBBB, RenderBold: true);
        }
        Button #BtnGlobalDb {
          Anchor: (Height: 40, Bottom: 8);
          Background: #2A2A2A;
          Label {
            Text: "global.db";
            Anchor: (Left: 15);
            Style: (TextColor: #FFB000, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }
        Button #BtnPlayersDb {
          Anchor: (Height: 40, Bottom: 8);
          Background: #000000(0);
          Label {
            Text: "players.db";
            Anchor: (Left: 15);
            Style: (TextColor: #BBBBBB, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }
        Button #BtnQuestsDb {
          Anchor: (Height: 40, Bottom: 8);
          Background: #000000(0);
          Label {
            Text: "quests.db";
            Anchor: (Left: 15);
            Style: (TextColor: #BBBBBB, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }
        Button #BtnEconomyDb {
          Anchor: (Height: 40, Bottom: 8);
          Background: #000000(0);
          Label {
            Text: "economy.db";
            Anchor: (Left: 15);
            Style: (TextColor: #BBBBBB, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }
        Group #Spacer {
          FlexWeight: 1;
        }
        Label #DevTitle {
          Text: "DEVELOPMENT";
          Anchor: (Bottom: 12);
          Padding: (Left: 10);
          Style: (FontSize: 12, TextColor: #BBBBBB, RenderBold: true);
        }
        Button #BtnTests {
          Anchor: (Height: 40);
          Background: #000000(0);
          Label {
            Text: "Integrated Tests";
            Anchor: (Left: 15);
            Style: (TextColor: #55FF55, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }
      }
      Group #MainContent {
        Anchor: (Width: 800);
        Padding: (Full: 30);
        LayoutMode: Top;
        FlexWeight: 1;
        Background: #0D0D0D;
        Group #StatsBar {
          Anchor: (Height: 70, Bottom: 30);
          LayoutMode: Left;
          Group #StatHitRate {
            Anchor: (Right: 20);
            LayoutMode: MiddleCenter;
            FlexWeight: 1;
            Background: #181818;
            Label {
              Text: "CACHE HIT RATE";
              Anchor: (Bottom: 8);
              Style: (FontSize: 13, TextColor: #BBBBBB);
            }
            Label #StatHitRateValue {
              Text: "0.0%";
              Style: (FontSize: 24, TextColor: #55FF55, RenderBold: true);
            }
          }
          Group #StatMemory {
            Anchor: (Right: 20);
            LayoutMode: MiddleCenter;
            FlexWeight: 1;
            Background: #181818;
            Label {
              Text: "MEMORY USAGE";
              Anchor: (Bottom: 8);
              Style: (FontSize: 13, TextColor: #BBBBBB);
            }
            Label #StatMemoryValue {
              Text: "0.0 MB";
              Style: (FontSize: 24, TextColor: #FFB000, RenderBold: true);
            }
          }
          Group #StatTotal {
            LayoutMode: MiddleCenter;
            FlexWeight: 1;
            Background: #181818;
            Label {
              Text: "TOTAL ENTITIES";
              Anchor: (Bottom: 8);
              Style: (FontSize: 13, TextColor: #BBBBBB);
            }
            Label #StatTotalValue {
              Text: "0";
              Style: (FontSize: 24, TextColor: #FFB000, RenderBold: true);
            }
          }
        }
        Group #ContentHeader {
          Anchor: (Height: 40, Bottom: 20);
          LayoutMode: Left;
          Group #TitleArea {
            LayoutMode: Left;
            FlexWeight: 1;
            Label #ContentTitle {
              Text: "global.db";
              Anchor: (Right: 10);
              Style: (FontSize: 24, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center);
            }
            Label #ContentSubtitle {
              Text: "Managing Core Entities";
              Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center);
            }
          }
          Button #BtnNewEntry {
            Anchor: (Height: 35);
            Padding: (Left: 15, Right: 15);
            Background: #FFB000;
            Label {
              Text: "+ New Entry";
              Style: (TextColor: #222222, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
        Group #Toolbar {
          Anchor: (Height: 35, Bottom: 15);
          LayoutMode: Left;
          Group #SearchArea {
            Anchor: (Width: 300, Right: 15);
            Background: #181818;
          }
          Button #BtnFilter {
            Anchor: (Width: 80);
            Background: #222222;
            Label {
              Text: "Filter";
              Style: (TextColor: #FFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
        Group #TableContainer {
          LayoutMode: Top;
          FlexWeight: 1;
          Group #TableHeader {
            Anchor: (Height: 30, Bottom: 8);
            Padding: (Left: 20, Right: 20);
            LayoutMode: Left;
            Label {
              Text: "ENTITY ID";
              FlexWeight: 3;
              Style: (FontSize: 13, TextColor: #BBBBBB, RenderBold: true, VerticalAlignment: Center);
            }
            Label {
              Text: "COLLECTION / CLASS";
              FlexWeight: 3;
              Style: (FontSize: 13, TextColor: #BBBBBB, RenderBold: true, VerticalAlignment: Center);
            }
            Label {
              Text: "SIZE";
              FlexWeight: 1;
              Style: (FontSize: 13, TextColor: #BBBBBB, RenderBold: true, VerticalAlignment: Center);
            }
            Label {
              Text: "TTL";
              FlexWeight: 1;
              Style: (FontSize: 13, TextColor: #BBBBBB, RenderBold: true, VerticalAlignment: Center);
            }
            Label {
              Text: "ACTIONS";
              FlexWeight: 2;
              Style: (FontSize: 13, TextColor: #BBBBBB, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Group #TableListContainer {
            LayoutMode: Top;
            FlexWeight: 1;
          Group #Row0 {
            Visible: false;
            Anchor: (Height: 45, Bottom: 8);
            Padding: (Left: 20, Right: 20);
            LayoutMode: Left;
            Background: #181818;
            Label #LblId0 { FlexWeight: 3; Style: (FontSize: 15, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center); }
            Label #LblType0 { FlexWeight: 3; Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center); }
            Label #LblSize0 { FlexWeight: 1; Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center); }
            Label #LblTtl0 { FlexWeight: 1; Style: (FontSize: 14, VerticalAlignment: Center); }
            Group {
              LayoutMode: Right; FlexWeight: 2;
              Button #BtnDel0 {
                Anchor: (Height: 30, Right: 10); Padding: (Left: 12, Right: 12); Background: #331111;
                Label { Text: "Delete"; Style: (TextColor: #FF5555, HorizontalAlignment: Center, VerticalAlignment: Center); }
              }
            }
          }
          Group #Row1 {

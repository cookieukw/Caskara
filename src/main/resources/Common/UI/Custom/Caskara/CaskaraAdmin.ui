            Label #LblType18 { FlexWeight: 3; Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center); }
            Label #LblSize18 { FlexWeight: 1; Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center); }
            Label #LblTtl18 { FlexWeight: 1; Style: (FontSize: 14, VerticalAlignment: Center); }
            Group {
              LayoutMode: Right; FlexWeight: 2;
              Button #BtnDel18 {
                Anchor: (Height: 30, Right: 10); Padding: (Left: 12, Right: 12); Background: #331111;
                Label { Text: "Delete"; Style: (TextColor: #FF5555, HorizontalAlignment: Center, VerticalAlignment: Center); }
              }
            }
          }
          Group #Row19 {
            Visible: false;
            Anchor: (Height: 45, Bottom: 8);
            Padding: (Left: 20, Right: 20);
            LayoutMode: Left;
            Background: #181818;
            Label #LblId19 { FlexWeight: 3; Style: (FontSize: 15, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center); }
            Label #LblType19 { FlexWeight: 3; Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center); }
            Label #LblSize19 { FlexWeight: 1; Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center); }
            Label #LblTtl19 { FlexWeight: 1; Style: (FontSize: 14, VerticalAlignment: Center); }
            Group {
              LayoutMode: Right; FlexWeight: 2;
              Button #BtnDel19 {
                Anchor: (Height: 30, Right: 10); Padding: (Left: 12, Right: 12); Background: #331111;
                Label { Text: "Delete"; Style: (TextColor: #FF5555, HorizontalAlignment: Center, VerticalAlignment: Center); }
              }
            }
          }
          }
          Group #PaginationContainer {
            Anchor: (Height: 40, Top: 15);
            LayoutMode: CenterMiddle;
            Group #PaginationControls {
              LayoutMode: Left;
              Button #BtnPrevPage {
                Anchor: (Height: 30, Right: 15);
                Padding: (Left: 15, Right: 15);
                Background: #222222;
                Label { Text: "Prev"; Style: (TextColor: #FFFFFF); }
              }
              Label #LblPageIndicator {
                Text: "Page 1 / 1";
                Anchor: (Right: 15);
                Style: (FontSize: 14, TextColor: #BBBBBB, VerticalAlignment: Center);
              }
              Button #BtnNextPage {
                Anchor: (Height: 30);
                Padding: (Left: 15, Right: 15);
                Background: #222222;
                Label { Text: "Next"; Style: (TextColor: #FFFFFF); }
              }
            }
          }
        }
      }
    }
  }
}
